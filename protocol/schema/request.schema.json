{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Marble-GP/AviUtl2_API/protocol/request.schema.json",
  "title": "AviUtl2 Live Bridge request",
  "type": "object",
  "required": [
    "id",
    "protocol_version",
    "method"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "protocol_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "method": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "params": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
